# =============================================================
# NextCRM — PRODUCTION environment configuration
# =============================================================
#
# Generated from this template by `scripts/setup-prod.sh`.
# Do not edit this file by hand for a live deployment — run:
#
#     bun run setup:prod
#
# which writes the materialized values to `.env.production`
# (mode 0600, gitignored). Re-run the script to rotate secrets
# or change config — it is idempotent.
#
# Placeholders below use the @@VAR@@ form. The script substitutes
# them via `sed`. Any line you do not want substituted, leave alone.
# =============================================================

# -------------------------------------------------------------
# Required: initial admin account
# -------------------------------------------------------------
# Becomes the admin user on first start. Passwordless Email OTP login;
# without a configured email provider, read the OTP from the database.
ADMIN_EMAIL=@@ADMIN_EMAIL@@
TEST_USER_EMAIL=@@ADMIN_EMAIL@@

# -------------------------------------------------------------
# Required: Postgres
# -------------------------------------------------------------
POSTGRES_USER=nextcrm
POSTGRES_PASSWORD=@@POSTGRES_PASSWORD@@
POSTGRES_DB=nextcrm
DB_HOST=postgres
DB_PORT=5432
DB_USER=nextcrm
DB_PASSWORD=@@POSTGRES_PASSWORD@@
DB_NAME=nextcrm
DATABASE_URL=postgresql://nextcrm:@@POSTGRES_PASSWORD@@@postgres:5432/nextcrm?schema=public

# -------------------------------------------------------------
# Required: MinIO / S3
# -------------------------------------------------------------
# To use external S3 (AWS, DigitalOcean Spaces, Backblaze B2),
# rewrite the four MINIO_* values below post-generation.
MINIO_ROOT_USER=nextcrm
MINIO_ROOT_PASSWORD=@@MINIO_ROOT_PASSWORD@@
MINIO_ENDPOINT=http://minio:9000
NEXT_PUBLIC_MINIO_ENDPOINT=@@DOMAIN@@
MINIO_PORT=9000
MINIO_BUCKET=nextcrm
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=nextcrm
MINIO_SECRET_KEY=@@MINIO_SECRET_KEY@@

# Host port bindings — production stack binds app on 3000 (mapped by nginx).
APP_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
INNGEST_PORT=8288
INNGEST_DEV_URL=http://app-production:3000/api/inngest

# -------------------------------------------------------------
# Required: Auth (Better Auth)
# -------------------------------------------------------------
# Generated by setup-prod.sh — `openssl rand -base64 32`.
# Rotating this invalidates all active sessions.
BETTER_AUTH_SECRET=@@BETTER_AUTH_SECRET@@
BETTER_AUTH_URL=@@DOMAIN@@
NEXTAUTH_URL=@@DOMAIN@@

# -------------------------------------------------------------
# Optional: Google OAuth
# -------------------------------------------------------------
GOOGLE_ID=@@GOOGLE_ID@@
GOOGLE_SECRET=@@GOOGLE_SECRET@@

# -------------------------------------------------------------
# Redis (bundled service)
# -------------------------------------------------------------
REDIS_URL=redis://redis:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -------------------------------------------------------------
# Required: Email encryption keys
# -------------------------------------------------------------
# Generated by setup-prod.sh — `openssl rand -hex 32`.
# Both must remain identical; rotating either invalidates stored
# encrypted email payloads.
EMAIL_ENCRYPTION_KEY=@@EMAIL_ENCRYPTION_KEY@@
ENCRYPTION_KEY=@@EMAIL_ENCRYPTION_KEY@@

# -------------------------------------------------------------
# Optional: Email — Engageo (transactional)
# -------------------------------------------------------------
ENGAGEO_BASE_URL=
ENGAGEO_MESSAGING_API_KEY=@@ENGAGEO_KEY@@
EMAIL_FROM=noreply@example.com

# -------------------------------------------------------------
# Optional: Email — SMTP / IMAP
# -------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=

# -------------------------------------------------------------
# Optional: AI / LLM
# -------------------------------------------------------------
# Leave empty to disable AI features. The ApiKeys table can also
# override these at runtime per-user / per-admin.
OPENAI_API_KEY=@@OPENAI_API_KEY@@
OPEN_AI_ORGANIZATION_ID=
# FIRECRAWL_API_KEY=
# E2B_API_KEY=
# E2B_ENRICHMENT_TEMPLATE=nextcrm-enrichment

# -------------------------------------------------------------
# Required: Inngest (workflow orchestration)
# -------------------------------------------------------------
# Bundled Inngest dev server. For prod-grade Inngest Cloud:
# - set INNGEST_DEV=0
# - set INNGEST_EVENT_KEY and INNGEST_SIGNING_KEY to your Cloud values
# - drop the inngest service from the compose stack
INNGEST_DEV=1
INNGEST_ID=nextcrm
INNGEST_APP_NAME=NextCRM
INNGEST_BASE_URL=http://inngest:8288
INNGEST_EVENT_KEY=@@INNGEST_EVENT_KEY@@
INNGEST_SIGNING_KEY=@@INNGEST_SIGNING_KEY@@

# -------------------------------------------------------------
# Optional: Internal security
# -------------------------------------------------------------
# CRON_SECRET=
# NEXTCRM_TOKEN=

# -------------------------------------------------------------
# App metadata (public)
# -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Le Circle Influent Sales
NEXT_PUBLIC_APP_URL=@@DOMAIN@@
NEXT_PUBLIC_APP_V=0.12.0

# Skip Next.js env validation at container build time; the production
# entrypoint validates connectivity (Postgres, MinIO) explicitly.
SKIP_ENV_VALIDATION=1
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
