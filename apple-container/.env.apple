# =============================================================
# NextCRM — Apple Container minimal env
# =============================================================
# Used by apple-container/up.sh
# Only Postgres + Next.js app are spun up. Redis/MinIO/Inngest
# are intentionally omitted — set placeholders only if needed.
# =============================================================

# Initial admin (real email if you want OTP delivery)
ADMIN_EMAIL=you@example.com

# Postgres
POSTGRES_USER=nextcrm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nextcrm

# App port on host
APP_PORT=3000

# Auth (auto-generated at container start if blank)
# BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email encryption (auto-generated if blank)
# EMAIL_ENCRYPTION_KEY=

# Engageo (transactional email)
ENGAGEO_BASE_URL=http://localhost:3030
ENGAGEO_MESSAGING_API_KEY=eng_live_iBpSaPsqDfTakXi-_j-cYUQ9cG6MZqkx-XsoQZGThgem5CWIikseNy31lxT0
EMAIL_FROM=test@dev.local
