# Lightweight development container.
# It intentionally does not copy source, install node_modules, or run next build.
# Optional Docker app profile; normal local development runs `bun dev` on the host.
FROM node:22-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates openssl && \
    rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9 --activate

WORKDIR /app

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
ENV PORT=3020
ENV HOSTNAME=0.0.0.0

EXPOSE 3020

CMD ["pnpm", "dev"]
